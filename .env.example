# ---------------------------------------------------------------------------
# Contact form delivery (src/app/api/contact/route.ts)
#
# Without these two set, the enquiry form returns a clear 503 instead of
# silently swallowing leads. Set them in Vercel > Settings > Environment
# Variables for Production, Preview and Development.
# ---------------------------------------------------------------------------

# From https://resend.com/api-keys
RESEND_API_KEY=

# The inbox that should receive enquiries.
# Note: until you verify your own sending domain in Resend, the shared
# onboarding sender can only deliver to the address that owns the Resend
# account — so use that address here first.
LEAD_NOTIFICATION_EMAIL=

# Optional. A verified sender on your own domain, e.g.
#   AgentCraft AI <hello@yourdomain.com>
# Leave blank to use Resend's shared onboarding sender.
LEAD_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Google Search Console (optional)
#
# From Search Console > Add property > URL prefix > HTML tag, copy only the
# content="..." value. Leave blank if you verified by another method.
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
